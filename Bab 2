        function cekJawaban2() {
            const pilihan = document.querySelector('input[name="q2"]:checked');
            const resultDiv = document.getElementById('result2');
            
            if (!pilihan) {
                resultDiv.style.color = "orange";
                resultDiv.innerText = "Pilih salah satu jawaban terlebih dahulu!";
                return;
            }

            if (pilihan.value === "b") {
                resultDiv.style.color = "green";
                resultDiv.innerText = "Benar! Berdasarkan Hukum III Kepler ($P^2 = a^3$), jika $a = 4$, maka $P^2 = 4^3 = 64$, sehingga $P = 8$ tahun.";
            } else {
                resultDiv.style.color = "red";
                resultDiv.innerText = "Kurang tepat. Ingat rumus Hukum III Kepler: $P = \\sqrt{a^3}$!";
            }
        }
